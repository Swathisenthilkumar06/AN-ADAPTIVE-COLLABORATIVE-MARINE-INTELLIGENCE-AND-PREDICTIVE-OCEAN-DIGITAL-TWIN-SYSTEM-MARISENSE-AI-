 private final class AppHandler extends HttpHandler:
 override def handle(exchange: HttpExchange): Unit =
 try
 val path = exchange.getRequestURI.getPath 22
 val method = exchange.getRequestMethod
 if method == "POST" && path == "/login" then login(exchange)
 else if path == "/logout" then logout(exchange)
 else if path == "/switch" then switchRole(exchange)
 else if method == "GET" && path == "/" then page(exchange)
 else respond(exchange, 404, "Not found")
 catch
 case error: Exception =>
 error.printStackTrace()
 respond(exchange, 500, "Internal server error")
 private def page(exchange: HttpExchange): Unit =
 val role = cookie(exchange, "marisense-role")
 role match
 case Some(activeRole) if accounts.contains(activeRole) => respond(exchange, 200, 
dashboard(activeRole))
 case _ => respond(exchange, 200, loginPage())
 private def login(exchange: HttpExchange): Unit =
 val values = formValues(exchange)
 val role = values.getOrElse("role", "fisherman")
 val password = values.getOrElse("password", "")
 if accounts.get(role).contains(password) then
 exchange.getResponseHeaders.add("Set-Cookie", s"marisense-role=$role; Path=/; 
SameSite=Lax")
 redirect(exchange, "/")
 else
 respond(exchange, 401, loginPage(Some("Access denied. Use the demo password for the 
selected bridge profile."))) 23
 private def logout(exchange: HttpExchange): Unit =
 exchange.getResponseHeaders.add("Set-Cookie", "marisense-role=; Max-Age=0; Path=/")
 redirect(exchange, "/")
 private def switchRole(exchange: HttpExchange): Unit =
 val role = queryValues(exchange).getOrElse("role", "fisherman")
 if accounts.contains(role) then
 exchange.getResponseHeaders.add("Set-Cookie", s"marisense-role=$role; Path=/; 
SameSite=Lax")
 redirect(exchange, "/")
 private def formValues(exchange: HttpExchange): Map[String, String] =
 val body = String(exchange.getRequestBody.readAllBytes(), StandardCharsets.UTF_8)
 parsePairs(body)
 private def queryValues(exchange: HttpExchange): Map[String, String] =
 parsePairs(Option(exchange.getRequestURI.getRawQuery).getOrElse(""))
 private def parsePairs(raw: String): Map[String, String] =
 raw.split("&").toList.filter(_.nonEmpty).flatMap { pair =>
 pair.split("=", 2).toList match
 case key :: value :: Nil => Some(decode(key) -> decode(value))
 case _ => None
 }.toMap
 private def decode(value: String): String = URLDecoder.decode(value, 
StandardCharsets.UTF_8)
 private def cookie(exchange: HttpExchange, name: String): Option[String] = 24
 Option(exchange.getRequestHeaders.getFirst("Cookie")).flatMap { raw =>
 raw.split(";").map(_.trim).find(_.startsWith(s"$name="))
 .map(_.drop(name.length + 1))
 }
 private def redirect(exchange: HttpExchange, location: String): Unit =
 exchange.getResponseHeaders.add("Location", location)
 exchange.sendResponseHeaders(303, -1)
 exchange.close()
 private def respond(exchange: HttpExchange, status: Int, body: String): Unit =
 val bytes = body.getBytes(StandardCharsets.UTF_8)
 exchange.getResponseHeaders.set("Content-Type", "text/html; charset=utf-8")
 exchange.getResponseHeaders.set("Cache-Control", "no-store")
 exchange.sendResponseHeaders(status, bytes.length)
 exchange.getResponseBody.write(bytes)
 exchange.close()
